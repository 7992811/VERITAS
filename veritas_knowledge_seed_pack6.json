    {
      "rule_id": "KP6_TREND_NATIVE_CONTINUATION",
      "source_id": "KP6_AQR_TREND_CENTURY",
      "school": "TREND",
      "factor_family": "MOMENTUM",
      "asset_scope": [
        "BTC",
        "ETH",
        "NQ",
        "MOEX",
        "BRENT",
        "GOLD",
        "CNYRUBF"
      ],
      "horizons": [
        "1h",
        "4h",
        "1d",
        "3d",
        "7d"
      ],
      "action": "LONG",
      "status": "shadow",
      "conditions": [
        {
          "field": "trend_direction_norm",
          "op": "==",
          "value": "LONG"
        },
        {
          "field": "trend_score_norm",
          "op": ">=",
          "value": 0.6
        }
      ],
      "prior_weight": 0.45,
      "hypothesis": "A strong native-horizon uptrend is continuation evidence; price strength alone is not a reason to block participation.",
      "mechanism": "Time-series momentum persistence."
    },
